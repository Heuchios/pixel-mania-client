extends SceneTree

func _initialize():
	call_deferred("run")

func run():
	var manager = load("res://Scripts/player_manager.gd").new()
	manager.free()
	var recovery = preload("res://Scripts/player_health_recovery.gd").new()
	assert(recovery.advance(2.9, 4, true) == 4)
	assert(recovery.advance(0.6, 4, true) == 5)
	recovery.damaged()
	assert(recovery.advance(2.9, 3, true) == 3, "Another hit restarts the delay")
	assert(recovery.advance(10, 3, true) == 10, "Health must return to full")
	assert(recovery.advance(10, 0, true) == 0, "Never revive during death")
	assert(recovery.advance(10, 3, false) == 3, "No healing outside gameplay")
	var bar = preload("res://Scripts/ui/player_health_bar.gd").new()
	root.add_child(bar)
	bar.set_process(false)
	bar.anchor = func(): return Vector2(160, 100)
	assert(not bar.visible)
	bar.set_health(6)
	bar._process(0.1)
	assert(bar.visible and is_equal_approx(bar.ratio, 0.6))
	assert(bar.global_position == Vector2(80, 78))
	assert(bar.health_color(1.0).is_equal_approx(Color("176b36")))
	assert(bar.health_color(0.0).is_equal_approx(Color("dc303a")))
	assert(not bar.health_color(0.9).is_equal_approx(bar.health_color(0.8)), "Color changes gradually with health")
	bar.set_health(10)
	bar._process(0.5)
	assert(bar.visible and is_equal_approx(bar.ratio, 1.0))
	bar._process(0.6)
	assert(not bar.visible)
	bar.set_health(5)
	bar._process(0.1)
	assert(bar.visible and bar.modulate.a == 1.0)
	bar.set_health(0)
	assert(not bar.visible)
	bar.free()
	print("PLAYER_HEALTH_BAR: PASS")
	quit()
